# ============================================================
# FixFlow — zmienne środowiskowe
# ============================================================
# Skopiuj ten plik jako .env i uzupełnij wartości:
#   cp .env.example .env
#
# NIGDY nie commituj pliku .env do repozytorium!
# ============================================================

# Django Core
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True

# Database (PostgreSQL)
DB_NAME=fixflow
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail SMTP Configuration
# Aby korzystać z Gmail, musisz:
# 1. Włączyć weryfikację dwuetapową na koncie Google
# 2. Wygenerować "Hasło do aplikacji" na https://myaccount.google.com/apppasswords
# 3. Wpisać poniżej swój adres Gmail i wygenerowane hasło
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Frontend URL (used in email links)
FIXFLOW_FRONTEND_URL=http://localhost:5173

# Backend URL (used for resolution token links in emails)
FIXFLOW_BACKEND_URL=http://127.0.0.1:8000
