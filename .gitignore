# Environment variables
.env

# Python
__pycache__/
*.py[cod]
*.pyo
venv/

# Media uploads
media/

# Node
frontend/node_modules/
frontend/dist/

# Scratch / utility / seed scripts
scratch_*.py
seed_*.py
